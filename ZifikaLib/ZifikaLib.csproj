<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Zifika</PackageId>
    <Version>1.0.0</Version>
    <Authors>Eriq VanBibber</Authors>
    <Description>Experimental keyed path-walking cipher with symmetric encryption and offline Mint/Verify origin verification.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alt160/Zifika</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UnusedCode/**/*.cs" />
    <None Remove="UnusedCode/**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Cleanup tasks.md" />
    <None Remove="[[Zifika]] Primer.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="2.0.0" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
